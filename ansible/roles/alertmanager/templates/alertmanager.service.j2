[Unit]
Description=Alertmanager
After=network.target

[Service]
User={{ alertmanager_user }}
Group={{ alertmanager_group }}
Type=simple
ExecStart={{ alertmanager_install_dir }}/alertmanager --config.file={{ alertmanager_config_dir }}/alertmanager.yml --storage.path={{ alertmanager_data_dir }} --web.listen-address=:{{ alertmanager_port }}
Restart=on-failure

[Install]
WantedBy=multi-user.target
